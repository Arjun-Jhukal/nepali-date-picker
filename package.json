{
    "name": "nepali-bs-date-picker",
    "version": "2.2.0",
    "description": "Nepali date picker and Nepali date range picker — vanilla JS, zero dependencies, Bikram Sambat (BS) ↔ AD conversion, 2082–2100 calendar data, drop-in <script> tag for plain HTML, WordPress, React, Vue.",
    "main": "dist/nepali-date-picker.umd.js",
    "module": "dist/nepali-date-picker.esm.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/nepali-date-picker.esm.js",
            "require": "./dist/nepali-date-picker.umd.js",
            "types": "./dist/types/index.d.ts"
        },
        "./css": "./dist/nepali-date-picker.min.css",
        "./dark": "./dist/nepali-date-picker.dark.min.css"
    },
    "sideEffects": [
        "./dist/*.css",
        "./src/picker/auto-init.ts"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "validate-data": "node scripts/validate-data.mjs",
        "prepublishOnly": "npm run build && npm test && npm run typecheck"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@vitest/coverage-v8": "^1.4.0",
        "esbuild": "^0.20.2",
        "jsdom": "^24.0.0",
        "typescript": "^5.4.0",
        "vitest": "^1.4.0"
    },
    "keywords": [
        "nepali",
        "nepali-date-picker",
        "nepali-date-range-picker",
        "nepali-date-picker-2026",
        "date-picker",
        "date-range-picker",
        "datepicker",
        "bikram",
        "sambat",
        "bikram-sambat",
        "bs-date-picker",
        "bs-to-ad",
        "ad-to-bs",
        "nepali-calendar",
        "nepali-calendar-2082",
        "nepali-calendar-2083",
        "vanilla-js",
        "wordpress",
        "react",
        "vue",
        "no-dependencies"
    ],
    "author": "Arjun Jhukal",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Arjun-Jhukal/nepali-date-picker"
    },
    "homepage": "https://github.com/Arjun-Jhukal/nepali-date-picker",
    "bugs": {
        "url": "https://github.com/Arjun-Jhukal/nepali-date-picker/issues"
    }
}
